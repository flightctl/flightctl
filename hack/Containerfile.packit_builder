FROM registry.access.redhat.com/ubi9/go-toolset:1.26.10 AS go-toolset

FROM quay.io/packit/packit:latest

USER 0

RUN mkdir -p /root/.config

RUN dnf install -y \
      golang \
      openssl-devel \
      go-rpm-macros \
      selinux-policy \
      pam-devel \
      selinux-policy-devel

RUN rm -rf /usr/lib/golang

COPY --from=go-toolset /usr/lib/golang /usr/lib/golang

ENV PATH=/usr/lib/golang/bin:$PATH

RUN dnf clean all

RUN (pip3 install --break-system-packages 'specfile>=0.40.0') || \
    (dnf install -y python3-pip && pip3 install --break-system-packages 'specfile>=0.40.0')

RUN install -d -m 0755 /root/go/pkg/mod && \
    install -d -m 0755 /root/.cache/go-build && \
    rm -rf /var/cache/dnf && mkdir /work

RUN pip3 install --break-system-packages 'specfile>=0.40.0'

COPY mock-site-defaults.cfg /etc/mock/site-defaults.cfg

COPY mock_prewarm_caches.sh /usr/bin/mock_prewarm_caches.sh

RUN git config --global --add safe.directory /work


# Store build timestamp for age checking
RUN echo "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > /etc/rpm-builder-image-timestamp-base

WORKDIR /work
