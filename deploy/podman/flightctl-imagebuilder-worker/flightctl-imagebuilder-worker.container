[Unit]
Description=Flight Control ImageBuilder Worker service
PartOf=flightctl.target
After=flightctl-db-wait.service flightctl-db-migrate.service flightctl-kv.service flightctl-certs-init.service
Wants=flightctl-db-wait.service flightctl-db-migrate.service flightctl-kv.service flightctl-certs-init.service

[Container]
ContainerName=flightctl-imagebuilder-worker
Image={{ .ImagebuilderWorker.Image }}:{{ .ImagebuilderWorker.Tag }}
Pull=missing
Network=flightctl.network
AddHost=%H:host-gateway
# Host-mounted signer and encryption keys are root-owned. Keep root UID while
# dropping every capability; all build/export privilege is confined to the guest.
User=0
Environment=HOME=/var/lib/flightctl
Environment=TMPDIR=/var/tmp
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
AddDevice=/dev/kvm
Tmpfs=/tmp:rw,size=64m,mode=1777
Volume=flightctl-imagebuilder-home:/var/lib/flightctl
Volume=flightctl-imagebuilder-scratch:/var/tmp
Secret=flightctl-postgresql-user-password,type=env,target=DB_PASSWORD
Secret=flightctl-kv-password,type=env,target=KV_PASSWORD
Environment=DB_USER=flightctl_app
Volume=/etc/flightctl/flightctl-imagebuilder-worker/config.yaml:/var/lib/flightctl/.flightctl/config.yaml:ro,z
Volume=/etc/flightctl/pki/flightctl-api/client-signer.crt:/var/lib/flightctl/.flightctl/certs/client-signer.crt:ro,z
Volume=/etc/flightctl/pki/flightctl-api/client-signer.key:/var/lib/flightctl/.flightctl/certs/client-signer.key:ro,z
Volume=/etc/flightctl/pki/ca-bundle.crt:/var/lib/flightctl/.flightctl/certs/ca-bundle.crt:ro,z
Volume=/etc/flightctl/encryption:/var/lib/flightctl/.flightctl/encryption:ro,z
Volume=/etc/flightctl/pki/db:/var/lib/flightctl/.flightctl/certs/db:ro,z
# Optional: Mount a CA bundle for verifying the Trustify server certificate (used for SBOM
# upload). Uncomment and point the source at your CA file, then set
# vulnerabilityReporting.trustify.caFile in service-config.yaml to the target path.
# Volume=/etc/flightctl/certs/vulnerability-ca.pem:/etc/flightctl/certs/vulnerability-ca.pem:ro,z
# Optional: Mount RHEL entitlement certs for subscription-only repos (auto-detected if present).
# On RHEL hosts with active subscription, uncomment to use host entitlements:
# Volume=/etc/pki/entitlement:/etc/pki/entitlement:ro,z
# Optional: Mount registry credentials for pulling builder service images from a private or
# air-gapped registry. Do NOT uncomment here — this file is vendor-owned and edits are lost
# on upgrade. Instead, create a drop-in:
#   /etc/containers/systemd/flightctl-imagebuilder-worker.container.d/auth.conf
# containing:
#   [Container]
#   Volume=/etc/flightctl/service-images-auth.json:/var/lib/flightctl/.config/containers/auth.json:ro,z

# The guest owns the build runtime and its file descriptor limits.
Ulimit=nofile=1048576:1048576

[Service]
Restart=always
RestartSec=30
Delegate=yes
LimitNOFILE=1048576

ExecStartPre=/usr/bin/flightctl-standalone render template --input-file /usr/share/flightctl/flightctl-imagebuilder-worker/config.yaml.template --output-file /etc/flightctl/flightctl-imagebuilder-worker/config.yaml

[Install]
WantedBy=flightctl.target
