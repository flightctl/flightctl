[Unit]
Description=Flight Control Worker service
PartOf=flightctl.target
After=flightctl-db-wait.service flightctl-db-migrate.service flightctl-kv.service flightctl-certs-init.service
Wants=flightctl-db-wait.service flightctl-db-migrate.service flightctl-kv.service flightctl-certs-init.service

[Container]
ContainerName=flightctl-worker
Image={{ .Worker.Image }}:{{ .Worker.Tag }}
Pull=missing
Network=flightctl.network
AddHost=%H:host-gateway
Environment=HOME=/root
Secret=flightctl-postgresql-user-password,type=env,target=DB_PASSWORD
Secret=flightctl-kv-password,type=env,target=KV_PASSWORD
Environment=DB_USER=flightctl_app
Volume=%E/flightctl/flightctl-worker/config.yaml:/root/.flightctl/config.yaml:ro,z
Volume=%E/flightctl/flightctl-worker/registries.conf.d:/etc/containers/registries.conf.d:ro,z
Volume=%E/flightctl/ssh:/etc/flightctl/ssh:ro,z
Volume=%E/flightctl/encryption:/root/.flightctl/encryption:ro,z
Volume=%E/flightctl/pki/db:/root/.flightctl/certs/db:ro,z

[Service]
Restart=always
RestartSec=30

ExecStartPre=/usr/bin/env PATH=%D/flightctl/bin:/usr/bin:/bin flightctl-standalone render template --config %E/flightctl/service-config.yaml --input-file %D/flightctl/flightctl-worker/config.yaml.template --output-file %E/flightctl/flightctl-worker/config.yaml

[Install]
WantedBy=flightctl.target
