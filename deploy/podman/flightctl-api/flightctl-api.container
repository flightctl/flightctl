[Unit]
Description=Flight Control API server
PartOf=flightctl.target
After=flightctl-db-wait.service flightctl-db-migrate.service flightctl-kv.service flightctl-api-init.service flightctl-certs-init.service
Wants=flightctl-db-wait.service flightctl-db-migrate.service flightctl-kv.service flightctl-api-init.service flightctl-certs-init.service

[Container]
ContainerName=flightctl-api
Image={{ .Api.Image }}:{{ .Api.Tag }}
Pull=missing
Network=flightctl.network
AddHost=%H:host-gateway
EnvironmentFile=%E/flightctl/flightctl-api/env
Secret=flightctl-postgresql-user-password,type=env,target=DB_PASSWORD
Secret=flightctl-kv-password,type=env,target=KV_PASSWORD
Environment=DB_USER=flightctl_app

Volume=%E/flightctl/pki/flightctl-api/server.crt:/root/.flightctl/certs/server.crt:ro,z
Volume=%E/flightctl/pki/flightctl-api/server.key:/root/.flightctl/certs/server.key:ro,z
Volume=%E/flightctl/pki/flightctl-api/client-signer.crt:/root/.flightctl/certs/client-signer.crt:ro,z
Volume=%E/flightctl/pki/flightctl-api/client-signer.key:/root/.flightctl/certs/client-signer.key:ro,z
Volume=%E/flightctl/pki/ca-bundle.crt:/root/.flightctl/certs/ca-bundle.crt:ro,z
Volume=%E/flightctl/flightctl-api/config.yaml:/root/.flightctl/config.yaml:ro,z
# TPM CA PEMs for enrollment (paths in service.tpmCAPaths must exist inside the container)
Volume=%E/flightctl/tpm-cas:/etc/flightctl/tpm-cas:ro,z
Volume=%E/flightctl/encryption:/root/.flightctl/encryption:ro,z
Volume=%E/flightctl/pki/db:/root/.flightctl/certs/db:ro,z
Volume=flightctl-listeners:/var/run/flightctl-listeners/:z

# This ensures that the unix socket allows root group access
PodmanArgs=--umask=0002

Ulimit=nofile=300000:300000

[Service]
Restart=always
RestartSec=30
LimitNOFILE=300000

ExecStartPre=/usr/bin/env PATH=%D/flightctl/bin:/usr/bin:/bin flightctl-standalone render template --config %E/flightctl/service-config.yaml --input-file %D/flightctl/flightctl-api/config.yaml.template --output-file %E/flightctl/flightctl-api/config.yaml
ExecStartPre=/usr/bin/env PATH=%D/flightctl/bin:/usr/bin:/bin flightctl-standalone render template --config %E/flightctl/service-config.yaml --input-file %D/flightctl/flightctl-api/env.template --output-file %E/flightctl/flightctl-api/env
ExecStartPost=/bin/bash -o pipefail -c 'if podman ps --filter name=flightctl-gateway --filter status=running --quiet | grep -q .; then podman exec flightctl-gateway nginx -s reload; else [ $$? -eq 1 ]; fi'

[Install]
WantedBy=flightctl.target
