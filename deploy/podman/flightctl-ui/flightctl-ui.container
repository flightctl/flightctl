[Unit]
Description=Flight Control UI
PartOf=flightctl.target
After=flightctl-api.service flightctl-ui-init.service
Wants=flightctl-ui-init.service

[Container]
ContainerName=flightctl-ui
Image={{ .Ui.Image }}:{{ .Ui.Tag }}
Pull=missing
Network=flightctl.network
AddHost=%H:host-gateway
EnvironmentFile=%E/flightctl/flightctl-ui/env

Volume=flightctl-ui-certs:/app/certs:ro,z

[Service]
Restart=always
RestartSec=30

ExecStartPre=/usr/bin/env PATH=%D/flightctl/bin:/usr/bin:/bin flightctl-standalone render template --config %E/flightctl/service-config.yaml --input-file %D/flightctl/flightctl-ui/env.template --output-file %E/flightctl/flightctl-ui/env

ExecStartPost=/bin/bash -o pipefail -c 'if podman ps --filter name=flightctl-gateway --filter status=running --quiet | grep -q .; then podman exec flightctl-gateway nginx -s reload; else [ $$? -eq 1 ]; fi'

[Install]
WantedBy=flightctl.target
