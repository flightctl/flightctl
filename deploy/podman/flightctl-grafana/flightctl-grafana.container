[Unit]
Description=Flight Control Grafana Dashboard
After=flightctl-network.service flightctl-prometheus.service flightctl-certs-init.service
Wants=flightctl-network.service flightctl-prometheus.service flightctl-certs-init.service
PartOf=flightctl-observability.target

[Container]
ContainerName=flightctl-grafana
Image={{ .Grafana.Image }}:{{ .Grafana.Tag }}
Pull=missing
PublishPort=3000:3000

Network=flightctl.network
AddHost=%H:host-gateway

# Volume for Grafana's primary data (database, compiled assets, plugins)
Volume=%S/grafana:/var/lib/grafana:rw,z,U

# Mount custom grafana.ini file
Volume=%E/flightctl/flightctl-grafana/grafana.ini:/etc/grafana/grafana.ini:ro,z

# Mount directory for data source provisioning
Volume=%E/flightctl/flightctl-grafana/provisioning/datasources:/etc/grafana/provisioning/datasources:ro,z

# Mount directory for dashboard provisioning
Volume=%E/flightctl/flightctl-grafana/provisioning/dashboards:/etc/grafana/provisioning/dashboards:ro,z

# Mount directory for TLS certificates (if using HTTPS)
Volume=%E/flightctl/pki/flightctl-grafana:/etc/grafana/certs:ro,z,U

# Downstream grafana image expects this
Volume=%E/flightctl/flightctl-grafana/provisioning/alerting:/etc/grafana/provisioning/alerting:ro,z

[Service]
Restart=on-failure
ExecStartPre=/usr/bin/env PATH=%D/flightctl/bin:/usr/bin:/bin flightctl-standalone render template --config %E/flightctl/service-config.yaml --input-file %D/flightctl/flightctl-grafana/grafana.ini.template --output-file %E/flightctl/flightctl-grafana/grafana.ini

[Install]
WantedBy=default.target
