[Unit]
Description=Flight Control Alertmanager Proxy service
PartOf=flightctl.target
After=flightctl-alertmanager.service flightctl-db-wait.service flightctl-db-migrate.service flightctl-certs-init.service
Wants=flightctl-alertmanager.service flightctl-db-wait.service flightctl-db-migrate.service flightctl-certs-init.service

[Container]
ContainerName=flightctl-alertmanager-proxy
Image={{ .AlertmanagerProxy.Image }}:{{ .AlertmanagerProxy.Tag }}
Pull=missing
Network=flightctl.network
AddHost=%H:host-gateway
EnvironmentFile=%E/flightctl/flightctl-alertmanager-proxy/env
Volume=%E/flightctl/flightctl-alertmanager-proxy/config.yaml:/root/.flightctl/config.yaml:ro,z
Volume=%E/flightctl/encryption:/root/.flightctl/encryption:ro,z
Volume=%E/flightctl/pki/db:/root/.flightctl/certs/db:ro,z
Secret=flightctl-postgresql-user-password,type=env,target=DB_PASSWORD
Environment=DB_USER=flightctl_app

[Service]
Restart=always
RestartSec=30

ExecStartPre=/usr/bin/env PATH=%D/flightctl/bin:/usr/bin:/bin flightctl-standalone render template --config %E/flightctl/service-config.yaml --input-file %D/flightctl/flightctl-alertmanager-proxy/config.yaml.template --output-file %E/flightctl/flightctl-alertmanager-proxy/config.yaml
ExecStartPre=/usr/bin/env PATH=%D/flightctl/bin:/usr/bin:/bin flightctl-standalone render template --config %E/flightctl/service-config.yaml --input-file %D/flightctl/flightctl-alertmanager-proxy/env.template --output-file %E/flightctl/flightctl-alertmanager-proxy/env

ExecStartPost=/bin/bash -o pipefail -c 'if podman ps --filter name=flightctl-gateway --filter status=running --quiet | grep -q .; then podman exec flightctl-gateway nginx -s reload; else [ $$? -eq 1 ]; fi'

[Install]
WantedBy=flightctl.target
