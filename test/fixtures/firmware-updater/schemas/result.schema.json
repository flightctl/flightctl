{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Updater contract fixture result",
  "description": "Protocol 1 result envelope; prepare reports Prepared and verify reports Verified or Pending.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "kind"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "action",
        "attemptID",
        "callID",
        "cycle",
        "name",
        "version",
        "descriptorDigest",
        "packageDigest",
        "manifestDigest",
        "configDigest",
        "intentDigest",
        "schemas",
        "grantDigest"
      ],
      "properties": {
        "protocol": {
          "type": "integer",
          "const": 1
        },
        "action": {
          "type": "string",
          "enum": [
            "prepare",
            "verify"
          ]
        },
        "attemptID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "callID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cycle": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
        },
        "descriptorDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "packageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "manifestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "configDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "intentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "planDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "observationDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "schemas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "config",
            "observation",
            "request",
            "result",
            "checkpoint"
          ],
          "properties": {
            "config": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "observation": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "request": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "result": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "checkpoint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "grantDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "checkpointDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "checkpointFormat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "checkpointRevision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "kind": {
      "type": "string",
      "enum": [
        "Prepared",
        "Verified",
        "Pending"
      ]
    },
    "observations": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name",
          "version",
          "digest",
          "active"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "component"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "active": {
            "type": "boolean"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components"
      ],
      "properties": {
        "components": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version",
              "digest",
              "active"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "active": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts",
        "selectionDigest",
        "authentication",
        "preflight"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name",
              "version",
              "digest"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "const": "component"
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "selectionDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selectionDigest",
            "evidence"
          ],
          "properties": {
            "selectionDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method"
              ],
              "properties": {
                "method": {
                  "type": "string",
                  "const": "synthetic"
                }
              }
            }
          }
        },
        "preflight": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selectionDigest",
            "evidence"
          ],
          "properties": {
            "selectionDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method"
              ],
              "properties": {
                "method": {
                  "type": "string",
                  "const": "synthetic"
                }
              }
            }
          }
        }
      }
    },
    "osReadiness": {
      "type": "string",
      "const": "Current"
    }
  }
}
