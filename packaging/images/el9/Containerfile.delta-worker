# ── vm-to-quadlet build stage ─────────────────────────────────────────────────
# Isolated from the main build to avoid module-cache contamination — the tool
# pins k8s.io at a different version than flightctl.
FROM registry.access.redhat.com/ubi9/go-toolset:1.27.3-1793884566 as vm-to-quadlet-build
USER 0
ARG VM_TO_QUADLET_COMMIT=2d2a64d59c10bbe33943e1c74835e5063177c3fb
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/root/go/pkg/mod \
    git clone https://github.com/flightctl/vm-to-quadlet /src && \
    cd /src && git checkout ${VM_TO_QUADLET_COMMIT} && \
    CGO_ENABLED=0 GOFIPS140=v1.0.0 GOEXPERIMENT=strictfipsruntime GOOS=linux go build -buildvcs=false -trimpath -ldflags="-s -w" -o /out/vm-to-quadlet ./cmd/vm-to-quadlet

# ── Helm CLI stage ───────────────────────────────────────────────────────────
FROM registry.access.redhat.com/ubi9/go-toolset:1.27.3-1793884566 as helm-build
USER 0
ARG HELM_COMMIT=5caf0044d4ef3d62a955440272999e139aafbbed
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/root/go/pkg/mod \
    git init /src && \
    git -C /src fetch --depth=1 https://github.com/helm/helm.git ${HELM_COMMIT} && \
    git -C /src checkout --detach FETCH_HEAD && \
    cd /src && \
    CGO_ENABLED=0 GOFIPS140=v1.0.0 GOEXPERIMENT=strictfipsruntime \
    go build -buildvcs=false -trimpath \
      -ldflags="-s -w -X helm.sh/helm/v4/internal/version.version=v4.1.1 -X helm.sh/helm/v4/internal/version.gitCommit=${HELM_COMMIT} -X helm.sh/helm/v4/internal/version.gitTreeState=clean" \
      -o /out/helm ./cmd/helm

# ── flightctl delta worker build stage ────────────────────────────────────────
FROM registry.access.redhat.com/ubi9/go-toolset:1.27.3-1793884566 as build
WORKDIR /app

# Switch to root for build operations
USER 0

RUN ARCH=$(uname -m) && \
    mkdir -p /runtime-root/etc/yum.repos.d && \
    echo -e "[centos-baseos]\nname=CentOS Stream 9 - BaseOS\nbaseurl=https://mirror.stream.centos.org/9-stream/BaseOS/${ARCH}/os/\nenabled=1\ngpgcheck=0" > /runtime-root/etc/yum.repos.d/centos.repo && \
    echo -e "[centos-appstream]\nname=CentOS Stream 9 - AppStream\nbaseurl=https://mirror.stream.centos.org/9-stream/AppStream/${ARCH}/os/\nenabled=1\ngpgcheck=0" >> /runtime-root/etc/yum.repos.d/centos.repo && \
    dnf install -y --installroot=/runtime-root --releasever=9 --setopt=install_weak_deps=False --nodocs \
        oci-delta openssl-libs tzdata && \
    dnf --installroot=/runtime-root clean all && \
    rm -rf /runtime-root/var/cache/dnf && \
    dnf --repofrompath=centos-baseos,https://mirror.stream.centos.org/9-stream/BaseOS/${ARCH}/os/ \
        --repofrompath=centos-appstream,https://mirror.stream.centos.org/9-stream/AppStream/${ARCH}/os/ \
        --repofrompath=centos-crb,https://mirror.stream.centos.org/9-stream/CRB/${ARCH}/os/ \
        --setopt=centos-baseos.gpgcheck=0 --setopt=centos-appstream.gpgcheck=0 --setopt=centos-crb.gpgcheck=0 \
        install -y ostree-devel gpgme-devel

# Copy dependencies first (most stable)
COPY go.mod go.sum ./

# Download dependencies (cached layer)
RUN --mount=type=cache,target=/opt/app-root/src/go/pkg/mod \
    go mod download

# Copy build tools and configs
COPY Makefile .

# Copy source code directories
COPY ./api ./api
COPY ./cmd ./cmd
COPY ./deploy ./deploy
COPY ./hack ./hack
COPY ./internal ./internal
COPY ./pkg ./pkg

# Define version info ARGs right before build
ARG SOURCE_GIT_TAG
ARG SOURCE_GIT_TREE_STATE
ARG SOURCE_GIT_COMMIT

# Convert ARGs to ENV so make can use them
ENV SOURCE_GIT_TAG=${SOURCE_GIT_TAG}
ENV SOURCE_GIT_TREE_STATE=${SOURCE_GIT_TREE_STATE}
ENV SOURCE_GIT_COMMIT=${SOURCE_GIT_COMMIT}

# Use BuildKit cache mounts for Go caching
RUN --mount=type=cache,target=/opt/app-root/src/.cache/go-build \
    --mount=type=cache,target=/opt/app-root/src/go/pkg/mod \
    make build-delta-worker install-oci-delta

FROM registry.access.redhat.com/ubi9/ubi-micro:9.8-1791895366
USER 0
COPY --from=build /runtime-root/ /
WORKDIR /app
LABEL \
  com.redhat.component="flightctl-delta-worker-container" \
  description="Flight Control Edge management service, OS delta generation worker" \
  io.k8s.description="Flight Control Edge management service, OS delta generation worker" \
  io.k8s.display-name="Flight Control Delta Worker" \
  name="flightctl-delta-worker" \
  summary="Flight Control Edge management service, OS delta generation worker"

COPY --from=build /app/bin/flightctl-delta-worker .
# Replace the distro executable with the pinned native-FIPS build.
COPY --from=build /app/bin/oci-delta /usr/bin/oci-delta
COPY --from=vm-to-quadlet-build /out/vm-to-quadlet /usr/local/bin/vm-to-quadlet
COPY --from=helm-build /out/helm /usr/local/bin/helm
CMD ["./flightctl-delta-worker"]
