FROM registry.access.redhat.com/ubi9/go-toolset:1.26.5-1787559109 as build
WORKDIR /app

# Switch to root for build operations
USER 0

RUN ARCH=$(uname -m) && \
    dnf install -y --nobest --nogpgcheck \
      --repofrompath "cs-baseos,https://mirror.stream.centos.org/9-stream/BaseOS/${ARCH}/os/" \
      --repofrompath "cs-appstream,https://mirror.stream.centos.org/9-stream/AppStream/${ARCH}/os/" \
      --repofrompath "cs-crb,https://mirror.stream.centos.org/9-stream/CRB/${ARCH}/os/" \
      ostree-devel && \
    dnf clean all

RUN dnf install -y --installroot=/runtime-root --setopt=install_weak_deps=False --nodocs \
      ostree-libs && \
    dnf --installroot=/runtime-root clean all

# Copy dependencies first (most stable)
COPY go.mod go.sum ./

# Download dependencies (cached layer)
RUN --mount=type=cache,target=/opt/app-root/src/go/pkg/mod \
    go mod download

# Copy build tools and configs
COPY Makefile .

# Copy source code directories
COPY ./api ./api
COPY ./cmd ./cmd
COPY ./deploy ./deploy
COPY ./hack ./hack
COPY ./internal ./internal
COPY ./pkg ./pkg
COPY ./test ./test

# Define version info ARGs right before build
ARG SOURCE_GIT_TAG
ARG SOURCE_GIT_TREE_STATE
ARG SOURCE_GIT_COMMIT

# Convert ARGs to ENV so make can use them
ENV SOURCE_GIT_TAG=${SOURCE_GIT_TAG}
ENV SOURCE_GIT_TREE_STATE=${SOURCE_GIT_TREE_STATE}
ENV SOURCE_GIT_COMMIT=${SOURCE_GIT_COMMIT}

# Use BuildKit cache mounts for Go caching
RUN --mount=type=cache,target=/opt/app-root/src/.cache/go-build \
    --mount=type=cache,target=/opt/app-root/src/go/pkg/mod \
    make build-delta-worker install-oci-delta

FROM quay.io/flightctl/flightctl-base:9.7-1762965531
USER 0
COPY --from=build /runtime-root/ /
WORKDIR /app
LABEL \
  com.redhat.component="flightctl-delta-worker-container" \
  description="Flight Control Edge management service, OS delta generation worker" \
  io.k8s.description="Flight Control Edge management service, OS delta generation worker" \
  io.k8s.display-name="Flight Control Delta Worker" \
  name="flightctl-delta-worker" \
  summary="Flight Control Edge management service, OS delta generation worker"
COPY --from=build /app/bin/flightctl-delta-worker .
COPY --from=build /app/bin/oci-delta /usr/local/bin/oci-delta
CMD ["./flightctl-delta-worker"]
