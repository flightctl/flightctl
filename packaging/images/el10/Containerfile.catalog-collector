FROM registry.access.redhat.com/ubi10/go-toolset:1.26.7-1790231490 as build
WORKDIR /app

# Switch to root for build operations
USER 0

# Install runtime dependencies into a separate root for the final image
RUN dnf install -y --installroot=/runtime-root --setopt=install_weak_deps=False --nodocs \
      openssl-libs tzdata ca-certificates && \
    dnf --installroot=/runtime-root clean all

# Copy dependencies first (most stable)
COPY go.mod go.sum ./

# Download dependencies (cached layer)
RUN --mount=type=cache,target=/opt/app-root/src/go/pkg/mod \
    go mod download

# Copy build tools and configs
COPY Makefile .

# Copy source code directories
COPY ./api ./api
COPY ./cmd ./cmd
COPY ./deploy ./deploy
COPY ./hack ./hack
COPY ./internal ./internal
COPY ./pkg ./pkg

# Define version info ARGs right before build
ARG SOURCE_GIT_TAG
ARG SOURCE_GIT_TREE_STATE
ARG SOURCE_GIT_COMMIT

# Convert ARGs to ENV so make can use them
ENV SOURCE_GIT_TAG=${SOURCE_GIT_TAG}
ENV SOURCE_GIT_TREE_STATE=${SOURCE_GIT_TREE_STATE}
ENV SOURCE_GIT_COMMIT=${SOURCE_GIT_COMMIT}

# Use BuildKit cache mounts for Go caching
RUN --mount=type=cache,target=/opt/app-root/src/.cache/go-build \
    --mount=type=cache,target=/opt/app-root/src/go/pkg/mod \
    make build-catalog-collector

FROM registry.access.redhat.com/ubi10/ubi-micro:10.2-1787684489
WORKDIR /app
LABEL \
  com.redhat.component="flightctl-catalog-collector-container" \
  description="Flight Control catalog collector, imports external model and application catalogs" \
  io.k8s.description="Flight Control catalog collector, imports external model and application catalogs" \
  io.k8s.display-name="Flight Control Catalog Collector" \
  name="flightctl-catalog-collector" \
  summary="Flight Control catalog collector, imports external model and application catalogs"
COPY --from=build /runtime-root/ /
COPY --from=build /app/bin/flightctl-catalog-collector .

# The collector only ever reads its configuration; it never writes to the
# filesystem. Running as a non-root UID keeps the image usable under the
# OpenShift restricted-v2 SCC and under a read-only root filesystem.
#
# The group is pinned to 0 explicitly rather than left to the base image.
# Mounted credentials are made readable by granting gid 0, both on Kubernetes
# (where OpenShift assigns an arbitrary uid but always gid 0) and on a Linux
# host (where "chown root:root" plus "chmod 0640" is the documented recipe),
# so the gid has to be a stable part of the image contract.
USER 1001:0

# 8888: Prometheus metrics (/metrics)
# 13133: health checks (/livez, /readyz)
EXPOSE 8888 13133

ENTRYPOINT ["./flightctl-catalog-collector"]
CMD ["--config", "/etc/flightctl/catalog-collector/config.yaml"]
