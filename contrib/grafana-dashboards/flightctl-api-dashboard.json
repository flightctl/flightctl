    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Service API latency on port 3443 by response status and percentile.",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 2
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "12.3.3",
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_sum{server_port=\"3443\"}[$__rate_interval])) / sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{server_port=\"3443\"}[$__rate_interval])) * 1000",
          "legendFormat": "{{http_response_status_code}} (avg)",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, http_response_status_code) (rate(http_server_request_duration_seconds_bucket{server_port=\"3443\"}[$__rate_interval]))) * 1000",
          "legendFormat": "{{http_response_status_code}} (p50)",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, http_response_status_code) (rate(http_server_request_duration_seconds_bucket{server_port=\"3443\"}[$__rate_interval]))) * 1000",
          "legendFormat": "{{http_response_status_code}} (p99)",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Service API LATENCY",
      "type": "timeseries"
    },
